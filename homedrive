#!/usr/bin/env bash
# Manage the HomeDrive server.  Usage: homedrive <command>
set -euo pipefail

# Where HomeDrive lives. Under sudo, $HOME is root's, so use the real user's home.
if [ -n "${HOMEDRIVE_DIR:-}" ]; then
  DIR="$HOMEDRIVE_DIR"
elif [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != "root" ]; then
  DIR="$(getent passwd "$SUDO_USER" | cut -d: -f6)/homedrive"
else
  DIR="$HOME/homedrive"
fi
SERVER="$DIR/server"
[ -d "$SERVER" ] || { echo "HomeDrive isn't installed in $DIR (set HOMEDRIVE_DIR if you moved it)."; exit 1; }
cd "$SERVER"
AGENT_DIR="$SERVER/data/agent"
OWNER="$(stat -c %u:%g "$SERVER")"   # the normal user who owns the install

# Use sudo only if this user can't talk to Docker yet (e.g. right after install).
DOCKER="docker"
docker info >/dev/null 2>&1 || DOCKER="sudo docker"
SUDO="sudo"
[ "$(id -u)" -eq 0 ] && SUDO=""

env_get() { grep "^$1=" .env 2>/dev/null | tail -1 | cut -d= -f2- | sed "s/^'//; s/'$//"; }
env_set() {
  (umask 077
   grep -v "^$1=" .env > .env.tmp || true
   printf "%s='%s'\n" "$1" "$2" >> .env.tmp
   mv .env.tmp .env)
  # When the helper runs this as root, keep .env owned by the normal user.
  [ "$(id -u)" -eq 0 ] && chown "$OWNER" .env || true
}

compose() {
  # Make the share-links folder ourselves, or Docker creates it owned by root.
  [ -d data/links ] || { mkdir -p data/links && { [ "$(id -u)" -ne 0 ] || chown "$OWNER" data/links; }; }
  local profile=()
  [ "$(env_get LINKS)" = "1" ] && profile=(--profile links)
  $DOCKER compose --env-file .env "${profile[@]}" "$@"
}

address() {
  echo "http://$(env_get BIND_IP):8090"
}

tailnet_name() {
  # This machine's name on Tailscale, e.g. server-macmini.tail92b8fb.ts.net
  tailscale status --json 2>/dev/null \
    | python3 -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))' 2>/dev/null
}

# Report progress to the Mac app (read by GET /api/admin/links).
agent_status() {  # state message [approve_url]
  mkdir -p "$AGENT_DIR"
  python3 - "$1" "$2" "${3:-}" > "$AGENT_DIR/status.tmp" <<'PY'
import json, sys, time
state, message, url = sys.argv[1:4]
print(json.dumps({"state": state, "message": message, "approve_url": url or None, "updated": time.time()}))
PY
  mv "$AGENT_DIR/status.tmp" "$AGENT_DIR/status.json"
  [ "$(id -u)" -eq 0 ] && chown "$OWNER" "$AGENT_DIR/status.json" || true
}

# Turn Tailscale Funnel on for the share-link server.
# Prints an approval URL and returns 2 if Tailscale needs you to allow Funnel first.
funnel_on() {
  local out code=0
  out=$($SUDO timeout 25 tailscale funnel --bg 8091 2>&1) || code=$?
  if [ "$code" -eq 0 ]; then return 0; fi
  local url
  url=$(printf '%s\n' "$out" | grep -oE 'https://login\.tailscale\.com/[^[:space:]]+' | head -1 || true)
  if [ -n "$url" ]; then echo "$url"; return 2; fi
  printf '%s\n' "$out" >&2
  return 1
}

links_on() {
  command -v tailscale >/dev/null || { echo "Tailscale isn't installed on the server."; return 1; }
  local name url code=0
  name=$(tailnet_name)
  [ -n "$name" ] || { echo "Couldn't find this machine's Tailscale name. Is Tailscale connected?"; return 1; }
  url=$(funnel_on) || code=$?
  if [ "$code" -eq 2 ]; then
    echo "$url"
    return 2
  elif [ "$code" -ne 0 ]; then
    echo "Tailscale couldn't turn on Funnel."
    return 1
  fi
  env_set LINKS 1
  env_set PUBLIC_URL "https://$name"
  compose up -d >/dev/null 2>&1
  echo "https://$name"
}

links_off() {
  $SUDO tailscale funnel --https=443 off >/dev/null 2>&1 || $SUDO tailscale funnel reset >/dev/null 2>&1 || true
  env_set LINKS 0
  env_set PUBLIC_URL ""
  $DOCKER compose --env-file .env --profile links rm -sf links >/dev/null 2>&1 || true
  compose up -d >/dev/null 2>&1
}

# ---------------------------------------------------------------- the new server
# `homedrive switch` replaces the Docker server with the new one (one program,
# Tailscale built in, device pairing). Same files folder; accounts, share links,
# stars and file history are copied over; the old data is left as it was, so
# `homedrive switch-back` returns to the Docker server at once.
USER_HOME="$(dirname "$DIR")"
OWNER_NAME="$(stat -c %U "$SERVER")"
NEW_DATA="$USER_HOME/.local/share/homedrive"
NEW_BIN="$USER_HOME/.local/bin/homedrive-server"
SWITCHED="$SERVER/data/.switched-to-new"

as_owner() {  # run a command as the install's owner (when this runs as root)
  if [ "$(id -u)" -eq 0 ]; then
    setpriv --reuid="${OWNER%%:*}" --regid="${OWNER##*:}" --clear-groups env HOME="$USER_HOME" "$@"
  else
    "$@"
  fi
}

install_new_server() {  # download the newest new-server build (fingerprint checked)
  local arch url tmp want got
  if [ -n "${HD_TEST_SERVER_BINARY:-}" ]; then  # tests: use a local build instead of downloading
    mkdir -p "$(dirname "$NEW_BIN")" && install -m 755 "$HD_TEST_SERVER_BINARY" "$NEW_BIN" && return 0
  fi
  case "$(uname -m)" in x86_64) arch=x64 ;; aarch64|arm64) arch=arm64 ;; *) echo "Unsupported computer type: $(uname -m)"; return 1 ;; esac
  url=$(curl -fsSL "https://api.github.com/repos/maxax4253/homedrive/releases?per_page=30" |
    grep -o '"browser_download_url": *"[^"]*"' | sed 's/.*"\(https:[^"]*\)"$/\1/' |
    grep "/download/server-v[^/]*/HomeDrive-Server-linux-$arch\.tar\.gz$" | head -1) || true
  [ -n "$url" ] || { echo "Couldn't find the new HomeDrive server to download."; return 1; }
  tmp=$(mktemp -d)
  if ! curl -fsSL -o "$tmp/s.tgz" "$url" || ! curl -fsSL -o "$tmp/SUMS" "${url%/*}/SHA256SUMS"; then
    rm -rf "$tmp"; echo "Download failed."; return 1
  fi
  want=$(grep " $(basename "$url")\$" "$tmp/SUMS" | cut -d' ' -f1)
  got=$(sha256sum "$tmp/s.tgz" | cut -d' ' -f1)
  if [ -z "$want" ] || [ "$want" != "$got" ]; then
    rm -rf "$tmp"; echo "The download doesn't match its fingerprint, so it wasn't installed."; return 1
  fi
  tar -C "$tmp" -xzf "$tmp/s.tgz" homedrive-server
  as_owner mkdir -p "$(dirname "$NEW_BIN")"
  install -m 755 "$tmp/homedrive-server" "$NEW_BIN.new"
  [ "$(id -u)" -ne 0 ] || chown "$OWNER" "$NEW_BIN.new"
  mv "$NEW_BIN.new" "$NEW_BIN"
  rm -rf "$tmp"
  echo "Installed HomeDrive $("$NEW_BIN" version)"
}

write_service() {
  $SUDO tee /etc/systemd/system/homedrive.service >/dev/null <<UNIT
[Unit]
Description=HomeDrive
After=network-online.target
Wants=network-online.target

[Service]
User=$OWNER_NAME
Environment=HOME=$USER_HOME
# The app's own page and API on 127.0.0.1:8093; Tailscale (built in) for your
# devices; share-link pages also on 127.0.0.1:8091, where Tailscale Funnel points.
ExecStart=$NEW_BIN app -no-tray -data $NEW_DATA -public-listen 127.0.0.1:8091
Restart=always
RestartSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
UNIT
  $SUDO systemctl daemon-reload
}

new_status() {
  if systemctl is-active --quiet homedrive; then echo "HomeDrive (new server) is running."; else echo "HomeDrive (new server) is NOT running: homedrive logs"; fi
  "$NEW_BIN" status -data "$NEW_DATA"
  df -h "$(env_get FILES_DIR | sed "s|^~|$USER_HOME|")" 2>/dev/null | tail -1 | awk '{print "Storage: " $3 " used, " $4 " free"}'
}

switch_to_new() {
  [ ! -f "$SWITCHED" ] || { echo "Already on the new server. (homedrive status, homedrive switch-back)"; exit 0; }
  command -v python3 >/dev/null || { echo "python3 is needed (sudo apt install python3)."; exit 1; }
  local files admin keep=""
  files=$(env_get FILES_DIR | sed "s|^~|$USER_HOME|")
  admin=$(env_get HOMEDRIVE_USERNAME)
  [ -d "$files" ] || { echo "Can't find your files folder ($files)."; exit 1; }
  echo "Switching HomeDrive to the new server."
  echo "  Files stay in $files (not copied or changed)."
  echo "  Accounts, share links, stars and file history are copied; the old server's data is kept."
  echo
  install_new_server || exit 1

  echo "Stopping the old (Docker) server..."
  $DOCKER compose --env-file .env --profile links down

  # A previous switch's data (from before a switch-back): keep its Tailscale
  # sign-in and device pairings, take everything else fresh from the old server.
  if [ -d "$NEW_DATA" ]; then
    keep="$NEW_DATA.previous-$(date +%Y%m%d-%H%M%S)"
    as_owner mv "$NEW_DATA" "$keep"
    echo "(Earlier new-server data moved to $keep)"
  fi
  if ! as_owner python3 "$SERVER/tools/move_to_new_server.py" "$SERVER/data" "$NEW_DATA" "$files" "$admin"; then
    echo "Copying failed. Starting the old server again; nothing was changed."
    compose up -d
    exit 1
  fi
  if [ -n "$keep" ]; then
    for d in tailscale devices.json; do
      if [ -e "$keep/$d" ]; then as_owner cp -a "$keep/$d" "$NEW_DATA/$d"; fi
    done
  fi

  write_service
  $SUDO systemctl enable --now homedrive
  touch "$SWITCHED"
  [ "$(id -u)" -ne 0 ] || chown "$OWNER" "$SWITCHED"

  echo
  echo "Waiting for the new server..."
  local shown="" st=""
  for _ in $(seq 1 300); do
    st=$("$NEW_BIN" status -data "$NEW_DATA" 2>/dev/null || true)
    case "$st" in
      *"HomeDrive is at"*|*"Tailscale problem"*) break ;;
      *"Connect HomeDrive to Tailscale"*)
        if [ -z "$shown" ]; then
          echo
          echo "One step left: sign HomeDrive in to Tailscale. Open this link on any device"
          echo "(e.g. your MacBook) and sign in with your usual Tailscale account:"
          echo "$st" | grep -o 'https://login.tailscale.com/[^ ]*'
          echo
          echo "(Waiting up to 10 minutes...)"
          shown=1
        fi ;;
    esac
    sleep 2
  done
  echo
  echo "$st"
  echo
  echo "Done: HomeDrive now runs as the new server. To use it on your Mac:"
  echo "  1. Open HomeDrive, Settings > Sign out, then sign in again with:"
  echo "  2. Server: the https address above. Name: $admin. Password: the same as before."
  echo "  3. Pairing code: $("$NEW_BIN" pair-code -data "$NEW_DATA" -user "$admin" 2>/dev/null)  (works once, for 10 minutes; homedrive pair makes a new one)"
  echo
  echo "Old share links keep working. Check everything with: homedrive selftest"
  echo "To go back to the old server: homedrive switch-back"
}

switch_back() {
  [ -f "$SWITCHED" ] || { echo "Already on the old (Docker) server."; exit 0; }
  $SUDO systemctl disable --now homedrive
  rm -f "$SWITCHED"
  compose up -d
  echo "Back on the old server at $(address)."
  echo "Your files are the same folder either way. Accounts, links or settings changed on the"
  echo "new server stay in $NEW_DATA (not copied back)."
}

# After the switch, the everyday commands work with the new server.
if [ -f "$SWITCHED" ]; then
  case "${1:-help}" in
    status)  new_status ;;
    url)     "$NEW_BIN" status -data "$NEW_DATA" | grep -o 'https://[^ ]*' || echo "Not connected to Tailscale yet: homedrive status" ;;
    update)
      echo "Updating HomeDrive..."
      as_owner git -C "$DIR" pull --ff-only || true
      sudo install -m 755 "$DIR/homedrive" /usr/local/bin/homedrive 2>/dev/null || true
      install_new_server && $SUDO systemctl restart homedrive && echo "Updated and restarted."
      ;;
    pair|pair-code)
      who="${2:-$(env_get HOMEDRIVE_USERNAME)}"
      echo "Pairing code for $who: $("$NEW_BIN" pair-code -data "$NEW_DATA" -user "$who" 2>/dev/null)"
      echo "Type it on the new device when it asks. Works once, for 10 minutes."
      ;;
    logs)    $SUDO journalctl -u homedrive -f -n 100 ;;
    restart|stop|start) $SUDO systemctl "$1" homedrive ;;
    selftest)
      HD_PAIR_CODE="$("$NEW_BIN" pair-code -data "$NEW_DATA" -user "$(env_get HOMEDRIVE_USERNAME)" 2>/dev/null)" \
        HD_URL="http://127.0.0.1:8093" HD_USER="$(env_get HOMEDRIVE_USERNAME)" HD_PASSWORD="$(env_get HOMEDRIVE_PASSWORD)" \
        HD_PUBLIC="http://127.0.0.1:8091" HD_DOCKER=false python3 "$SERVER/selftest.py"
      ;;
    password)
      read -rsp "New HomeDrive password: " pw < /dev/tty; echo
      [ -n "$pw" ] || { echo "Password can't be empty."; exit 1; }
      if [ "${#pw}" -lt 8 ]; then
        echo "That's short and easy to guess. 8+ characters is strongly recommended."
        read -rp "Use it anyway? [y/N] " ok < /dev/tty
        case "$ok" in y|Y|yes) ;; *) echo "Not changed."; exit 1 ;; esac
      fi
      case "$pw" in *"'"*) echo "Please don't use a ' (single quote) in the password."; exit 1 ;; esac
      $SUDO systemctl stop homedrive
      printf '%s' "$pw" | as_owner "$NEW_BIN" password -data "$NEW_DATA" -user "$(env_get HOMEDRIVE_USERNAME)"
      $SUDO systemctl start homedrive
      env_set HOMEDRIVE_PASSWORD "$pw"   # keeps selftest (and a switch-back) in step
      ;;
    switch)      switch_to_new ;;
    switch-back) switch_back ;;
    *)
      cat <<HELP
homedrive: manage your HomeDrive (new server)

  homedrive status        is it running, its address, Tailscale, space left
  homedrive url           the address to sign in with
  homedrive pair [name]   a one-time code to sign in on a new device
  homedrive update        download the newest version and restart
  homedrive logs          follow the server log (Ctrl+C to stop)
  homedrive restart | stop | start
  homedrive selftest      check that everything works
  homedrive password      change the admin password
  homedrive switch-back   go back to the old (Docker) server
HELP
      ;;
  esac
  exit 0
fi

case "${1:-help}" in
  switch)      switch_to_new ;;
  switch-back) switch_back ;;
  status)
    compose ps
    echo
    if curl -fsS "$(address)/api/health" >/dev/null 2>&1; then
      echo "Running at $(address)"
    else
      echo "Not responding at $(address)"
    fi
    df -h "$(env_get FILES_DIR)" 2>/dev/null | tail -1 | awk '{print "Storage: " $3 " used, " $4 " free"}'
    if [ -n "$(env_get BACKUP_DIR)" ]; then echo "Backups: on, to $(env_get BACKUP_DIR)"; else echo "Backups: off"; fi
    if [ "$(env_get LINKS)" = "1" ]; then echo "Share links: on, $(env_get PUBLIC_URL)"; else echo "Share links: off"; fi
    if systemctl is-active --quiet homedrive-agent.path 2>/dev/null; then echo "App helper: running"; else echo "App helper: not installed (sudo homedrive install-agent)"; fi
    ;;
  update)
    echo "Updating HomeDrive..."
    if [ "$(id -u)" -eq 0 ]; then
      # Run git as the install's owner so root never takes over the files.
      setpriv --reuid="${OWNER%%:*}" --regid="${OWNER##*:}" --clear-groups \
        env HOME="$(dirname "$DIR")" git -C "$DIR" pull --ff-only
    else
      git -C "$DIR" pull --ff-only
    fi
    sudo install -m 755 "$DIR/homedrive" /usr/local/bin/homedrive 2>/dev/null || true
    # --pull fetches the newest Python base image, so its security fixes come along too.
    compose build --pull
    compose up -d
    sudo HOMEDRIVE_DIR="$DIR" /usr/local/bin/homedrive install-agent >/dev/null 2>&1 || true
    echo "Updated. Running at $(address)"
    ;;
  selftest)
    # End-to-end check of the running server; cleans up after itself.
    HD_URL="$(address)" HD_USER="$(env_get HOMEDRIVE_USERNAME)" HD_PASSWORD="$(env_get HOMEDRIVE_PASSWORD)" \
      HD_PUBLIC="$( [ "$(env_get LINKS)" = "1" ] && env_get PUBLIC_URL )" \
      HD_DOCKER="$DOCKER" \
      python3 "$SERVER/selftest.py"
    ;;
  restart) compose restart ;;
  stop)    compose stop ;;
  start)   compose up -d ;;
  logs)    compose logs -f --tail 100 ;;
  url)     address ;;
  links)
    case "${2:-status}" in
      on)
        echo "Turning on public share links through Tailscale Funnel."
        echo "Only the share-link pages are exposed; your files and login stay Tailscale-only."
        code=0
        result=$(links_on) || code=$?
        if [ "$code" -eq 2 ]; then
          echo "Tailscale needs your OK first. Open this link, allow HTTPS/Funnel, then run this again:"
          echo "  $result"
          exit 1
        elif [ "$code" -ne 0 ]; then
          echo "$result"; exit 1
        fi
        echo "Share links are on: $result/s/..."
        ;;
      off)
        links_off
        echo "Share links are off. Existing links stop working until you turn them back on."
        ;;
      *)
        if [ "$(env_get LINKS)" = "1" ]; then echo "Share links: on ($(env_get PUBLIC_URL))"; else echo "Share links: off"; fi
        ;;
    esac
    ;;
  agent)
    # Run by systemd (homedrive-agent.service) when the Mac app asks for something.
    request="$AGENT_DIR/request.json"
    [ -f "$request" ] || exit 0
    action=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("action",""))' "$request" 2>/dev/null || true)
    rm -f "$request"
    case "$action" in
      links-on)
        agent_status working "Turning share links on…"
        code=0
        result=$(links_on 2>&1) || code=$?
        if [ "$code" -eq 0 ]; then
          agent_status "done" "Share links are on: $result"
        elif [ "$code" -eq 2 ]; then
          agent_status needs_approval "Tailscale needs your OK to make share links public. Approve it, then turn the switch on again." "$result"
        else
          agent_status error "Couldn't turn share links on: $result"
        fi
        ;;
      update)
        agent_status working "Updating the server…"
        if out=$(HOMEDRIVE_DIR="$DIR" /usr/local/bin/homedrive update 2>&1); then
          agent_status "done" "Server updated."
        else
          agent_status error "Update failed: $(printf '%s\n' "$out" | tail -1)"
        fi
        ;;
      links-off)
        agent_status working "Turning share links off…"
        if links_off; then agent_status "done" "Share links are off."; else agent_status error "Couldn't turn share links off."; fi
        ;;
      *)
        agent_status error "Unknown request: $action"
        ;;
    esac
    ;;
  install-agent)
    # Lets the Mac app flip server settings (like share links) without SSH.
    if [ "$(id -u)" -ne 0 ]; then
      exec sudo HOMEDRIVE_DIR="$DIR" "$0" install-agent
    fi
    mkdir -p "$AGENT_DIR" "$SERVER/data/links"
    chown "$OWNER" "$SERVER/data" "$AGENT_DIR" "$SERVER/data/links"
    cat > /etc/systemd/system/homedrive-agent.path <<EOF
[Unit]
Description=HomeDrive helper (waits for requests from the Mac app)

[Path]
PathExists=$AGENT_DIR/request.json

[Install]
WantedBy=multi-user.target
EOF
    cat > /etc/systemd/system/homedrive-agent.service <<EOF
[Unit]
Description=HomeDrive helper (runs a request from the Mac app)

[Service]
Type=oneshot
Environment=HOMEDRIVE_DIR=$DIR
ExecStart=/usr/local/bin/homedrive agent
EOF
    systemctl daemon-reload
    systemctl enable --now homedrive-agent.path >/dev/null 2>&1
    echo 1 > "$AGENT_DIR/installed"
    chown "$OWNER" "$AGENT_DIR/installed"
    echo "App helper installed: you can now turn share links on and off from the Mac app."
    ;;
  backup)
    case "${2:-status}" in
      now)    compose exec homedrive python -m app.cli backup-now ;;
      status) compose exec homedrive python -m app.cli backup-status ;;
      off)
        env_set BACKUP_DIR ""
        compose up -d
        echo "Nightly backups are off (existing snapshots were left where they are)."
        ;;
      *)
        target="$2"
        [ "${target#/}" != "$target" ] || { echo "Use a full path, e.g.: homedrive backup /mnt/backup"; exit 1; }
        mkdir -p "$target" 2>/dev/null || sudo mkdir -p "$target"
        [ -w "$target" ] || sudo chown "$(id -u):$(id -g)" "$target"
        env_set BACKUP_DIR "$target"
        compose up -d
        echo "Nightly backups are on: every night at 3am to $target"
        echo "Run one right now with: homedrive backup now"
        ;;
    esac
    ;;
  password)
    read -rsp "New HomeDrive password: " pw < /dev/tty; echo
    [ -n "$pw" ] || { echo "Password can't be empty."; exit 1; }
    if [ "${#pw}" -lt 8 ]; then
      echo "That's short and easy to guess. 8+ characters is strongly recommended."
      read -rp "Use it anyway? [y/N] " ok < /dev/tty
      case "$ok" in y|Y|yes) ;; *) echo "Not changed."; exit 1 ;; esac
    fi
    case "$pw" in *"'"*) echo "Please don't use a ' (single quote) in the password."; exit 1 ;; esac
    (umask 077
     grep -v '^HOMEDRIVE_PASSWORD=' .env > .env.tmp || true
     printf "HOMEDRIVE_PASSWORD='%s'\n" "$pw" >> .env.tmp
     mv .env.tmp .env)
    compose up -d
    echo "Password changed. Sign in again in the app."
    ;;
  *)
    cat <<EOF
homedrive: manage your HomeDrive server

  homedrive status     is it running, where, and how much space is left
  homedrive update     download the latest version and restart
  homedrive logs       follow the server log (Ctrl+C to stop)
  homedrive restart    restart the server
  homedrive stop       stop the server
  homedrive start      start it again
  homedrive url        print the address to use in the Mac app
  homedrive selftest   check that everything works (uploads, history, accounts, share links)
  homedrive password   change the admin password

  homedrive backup /mnt/backup   turn on nightly backups to that folder
  homedrive backup now           back up right now
  homedrive backup off           turn nightly backups off

  homedrive links on   turn on public share links (Tailscale Funnel)
  homedrive links off  turn them off
  homedrive install-agent   let the Mac app turn share links on/off (done by install/update)

  homedrive switch     move to the new server (no Docker, Tailscale built in, device pairing;
                       keeps your files, accounts and share links; homedrive switch-back undoes it)
EOF
    ;;
esac
