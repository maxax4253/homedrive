<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>HomeDrive</string>
    <key>CFBundleDisplayName</key>
    <string>HomeDrive</string>
    <key>CFBundleIdentifier</key>
    <string>com.maxkaplan.homedrive</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <key>CFBundleExecutable</key>
    <string>HomeDrive</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>0.8.2</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <!-- Finder right-click > Services (or Quick Actions). Empty NSRequiredContext = on by default. -->
    <key>NSServices</key>
    <array>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Move to HomeDrive</string>
            </dict>
            <key>NSMessage</key>
            <string>moveToHomeDrive</string>
            <key>NSPortName</key>
            <string>HomeDrive</string>
            <key>NSSendFileTypes</key>
            <array>
                <string>public.item</string>
            </array>
            <key>NSRequiredContext</key>
            <dict/>
        </dict>
        <dict>
            <key>NSMenuItem</key>
            <dict>
                <key>default</key>
                <string>Copy to HomeDrive</string>
            </dict>
            <key>NSMessage</key>
            <string>copyToHomeDrive</string>
            <key>NSPortName</key>
            <string>HomeDrive</string>
            <key>NSSendFileTypes</key>
            <array>
                <string>public.item</string>
            </array>
            <key>NSRequiredContext</key>
            <dict/>
        </dict>
    </array>
    <!-- Drag type used to move files between folders inside the app. -->
    <key>UTExportedTypeDeclarations</key>
    <array>
        <dict>
            <key>UTTypeIdentifier</key>
            <string>com.maxkaplan.homedrive.item</string>
            <key>UTTypeDescription</key>
            <string>HomeDrive item</string>
            <key>UTTypeConformsTo</key>
            <array>
                <string>public.data</string>
            </array>
        </dict>
    </array>
    <!-- The server is plain http over Tailscale (already encrypted), so allow it. -->
    <key>NSAppTransportSecurity</key>
    <dict>
        <key>NSAllowsArbitraryLoads</key>
        <true/>
    </dict>
</dict>
</plist>
